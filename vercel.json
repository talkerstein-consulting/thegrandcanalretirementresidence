{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"static site, nothing to install\"",
  "buildCommand": "echo \"static site, prebuilt in public/\"",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/review/?",
      "status": 301,
      "headers": {
        "Location": "https://g.page/r/CcJxCH5hN_VUEAg/review"
      }
    },
    {
      "src": "/(.+)/",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/_files/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      },
      "continue": true
    },
    {
      "src": "/m/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex"
      },
      "continue": true
    },
    {
      "src": "/((?!assets/).*)",
      "headers": {
        "Vary": "User-Agent",
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|iPod|Android.*Mobile|Windows Phone|BlackBerry|BB10|Opera Mini|IEMobile|webOS.*Mobile).*"
        }
      ],
      "dest": "/m/index.html"
    },
    {
      "src": "/((?!assets/|m/|_files/|sitemap\\.xml|robots\\.txt|blog-feed\\.xml)[^.]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|iPod|Android.*Mobile|Windows Phone|BlackBerry|BB10|Opera Mini|IEMobile|webOS.*Mobile).*"
        }
      ],
      "dest": "/m/$1/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/([^.]+)",
      "dest": "/$1/index.html"
    }
  ]
}
